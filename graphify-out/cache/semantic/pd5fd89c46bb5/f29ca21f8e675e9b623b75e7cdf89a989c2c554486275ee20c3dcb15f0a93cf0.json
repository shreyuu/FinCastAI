{"nodes": [{"id": "readme_fincastai", "label": "FinCastAI", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_react_frontend", "label": "React Frontend", "file_type": "concept", "source_file": "README.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_prediction_api", "label": "Prediction API (FastAPI)", "file_type": "concept", "source_file": "README.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_auth_server", "label": "Auth Server (Express)", "file_type": "concept", "source_file": "README.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mysql_users_table", "label": "MySQL users table", "file_type": "concept", "source_file": "README.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_yahoo_finance", "label": "Yahoo Finance (yfinance)", "file_type": "concept", "source_file": "README.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_newsdata_io", "label": "NewsData.io", "file_type": "concept", "source_file": "README.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_hugging_face_hub", "label": "Hugging Face Hub", "file_type": "concept", "source_file": "README.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_svr_forecaster", "label": "SVR Forecaster", "file_type": "concept", "source_file": "README.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RBF SVR with fixed C=1e3, gamma=0.1, trained on at most the latest 2,520 rows so one request cannot monopolise the CPU; hold-out metrics only reach the server log."}, {"id": "readme_finbert_sentiment", "label": "FinBERT Sentiment", "file_type": "concept", "source_file": "README.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loaded once at startup; headlines scored in one batch into a mean signed score between -1 and 1; a FinBERT failure is currently reported as neutral (CHARACTERISES ERR-01)."}, {"id": "readme_technical_indicators", "label": "Technical Indicators (EMA, RSI, MACD, Bollinger Bands, OBV)", "file_type": "concept", "source_file": "README.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computed from three months of daily prices because MACD needs 26 sessions."}, {"id": "readme_trade_call_rule", "label": "Trade Call Rule (Buy/Sell/Hold/Avoid/No Action)", "file_type": "rationale", "source_file": "README.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines sentiment thresholds (+/-0.05) with RSI bounds (70/30) and whether the user already holds the stock."}, {"id": "readme_sentiment_forecast_adjustment", "label": "Sentiment Forecast Adjustment (1 + 0.1 x s)", "file_type": "rationale", "source_file": "README.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "News sentiment nudges the SVR forecast by at most +/-10%."}, {"id": "readme_nse_holiday_calendar", "label": "NSE Holiday Calendar (2025)", "file_type": "concept", "source_file": "README.md", "source_location": "L366", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MARKET_HOLIDAYS_2025 is the only list, so forecast dates after 2025 skip weekends but not exchange holidays."}, {"id": "readme_predict_stock_endpoint", "label": "GET /predict_stock", "file_type": "concept", "source_file": "README.md", "source_location": "L267", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_indicotor_endpoint", "label": "POST /Indicotor", "file_type": "concept", "source_file": "README.md", "source_location": "L270", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_news_impact_endpoint", "label": "GET /news-impact/{company}", "file_type": "concept", "source_file": "README.md", "source_location": "L269", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stock_prices_endpoint", "label": "GET /stock-prices", "file_type": "concept", "source_file": "README.md", "source_location": "L266", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_market_snapshot", "label": "Market Snapshot", "file_type": "concept", "source_file": "README.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_svm_research_script", "label": "svm.py SVC Research Script", "file_type": "concept", "source_file": "README.md", "source_location": "L370", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SVC direction classifier with GridSearchCV tuning kept standalone; wiring it into the API is on the roadmap."}, {"id": "readme_train_on_demand", "label": "Train on Demand", "file_type": "rationale", "source_file": "README.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No stored model: each forecast fits a fresh scaler and SVR so results follow the latest data, at the cost of latency on every request."}, {"id": "readme_batch_the_slow_parts", "label": "Batch the Slow Parts", "file_type": "rationale", "source_file": "README.md", "source_location": "L118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FinBERT scores all headlines in one call, /stock-prices uses one yfinance download cached 60 s behind a lock, and /predict reuses the downloaded frame for the current quote."}, {"id": "readme_real_status_codes", "label": "Real Status Codes", "file_type": "rationale", "source_file": "README.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "404/422/429/502 each carry a detail message the dashboard shows as-is; the 502 message is fixed so exception details stay in the server log."}, {"id": "readme_rate_limits", "label": "Rate Limits", "file_type": "rationale", "source_file": "README.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes that train a model or spend a NewsData credit share a per-IP budget (10/minute); auth allows 10 failed logins per 15 min and 5 sign-ups per hour. Limits are in-memory per process, so proxies must forward client addresses."}, {"id": "readme_bcrypt_forced_reset", "label": "bcrypt with Forced-Reset Path", "file_type": "rationale", "source_file": "README.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwords are bcrypt hashes (10 rounds); legacy accounts get 403 PASSWORD_RESET_REQUIRED. No self-service reset because without email verification it would be an account-takeover route."}, {"id": "readme_offline_tests", "label": "Offline Tests", "file_type": "rationale", "source_file": "README.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "conftest.py replaces transformers.pipeline before import, Yahoo Finance and NewsData.io are faked, and auth tests mock MySQL, so suites need no network, model download or database."}, {"id": "readme_no_real_sessions", "label": "No Real Sessions", "file_type": "rationale", "source_file": "README.md", "source_location": "L367", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Login returns the user record kept in localStorage; no token is issued, the prediction API is unauthenticated and pages have no route guards."}, {"id": "readme_migration_001", "label": "Migration 001 (force password reset)", "file_type": "concept", "source_file": "README.md", "source_location": "L193", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_set_password_cli", "label": "set-password CLI", "file_type": "concept", "source_file": "README.md", "source_location": "L296", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_disclaimer", "label": "Disclaimer", "file_type": "document", "source_file": "README.md", "source_location": "L406", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_fincastai", "target": "readme_react_frontend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L53", "weight": 1.0}, {"source": "readme_fincastai", "target": "readme_prediction_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L53", "weight": 1.0}, {"source": "readme_fincastai", "target": "readme_auth_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L53", "weight": 1.0}, {"source": "readme_disclaimer", "target": "readme_fincastai", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L408", "weight": 1.0}, {"source": "readme_react_frontend", "target": "readme_prediction_api", "relation": "references", "confidence": "E