# Auth server environment configuration.
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# === Database ===
# All four are required; the server refuses to start without them.
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional, defaults to 3306.
DB_PORT=3306

# === Server ===
# Optional, defaults to 3001. Must match VITE_AUTH_URL in the frontend.
PORT=3001
